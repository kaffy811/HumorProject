NEXT_PUBLIC_SUPABASE_URL=https://wqkpatxsbxwjsupojjcq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy service-role key is supported as a fallback.
